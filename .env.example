# ═══════════════════════════════════════════════════════════
#  配置模板 —— 复制为 .env 后填写
#
#      cp .env.example .env
#
#  ⚠️ .env 已被 .gitignore 挡住，**永远不要**提交它。
#
#  注意：这里【没有】ncss 的账号密码，这是刻意的设计。
#  登录走半自动方案（PLAN.md §M2）：Playwright 打开有头浏览器，
#  由主人亲自输入账号密码并过图形验证码，程序只保存登录态。
#  也就是说 —— 凭据从不经过本程序的代码，也不落盘。
# ═══════════════════════════════════════════════════════════


# ── LLM（国内 OpenAI 兼容接口）──────────────────────────────
# DeepSeek:  https://api.deepseek.com/v1        model: deepseek-chat
# 通义千问:  https://dashscope.aliyuncs.com/compatible-mode/v1  model: qwen-plus
# ★ 下面四个都是【必填】：代码里没有默认值（见 src/agent/config.py）。
#   ⚠️ BASE_URL 与 MODEL 必须【成对】改 —— 只换 URL 忘了换 model，
#     就会把 deepseek-chat 发给通义，报一个看不懂的错。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# 单次 LLM 调用的超时（秒）。必填 —— 没有默认值，缺了启动即报错。
# 注意：重试不在这里做，属于编排层（M4）
LLM_TIMEOUT_SECONDS=60


# ── Agent 预算闸门（M3/M4：防止死循环烧钱）───────────────────
# ★ 三个都是【必填】：代码里没有默认值（见 runtime/budget.py 的 from_env）。
#   缺任何一个、或留成空的 `AGENT_MAX_STEPS=`，程序都在启动时当场报错，
#   而不是悄悄用一个代码里的数 —— 少算的账本比没有账本更危险。
AGENT_MAX_STEPS=20
AGENT_MAX_TOKENS=200000
AGENT_WALL_CLOCK_SECONDS=600


# ── 数据源（M2）────────────────────────────────────────────
# remoteok = 开发期替身：零登录、零对抗、零风险，用于 M1~M3 快速迭代
# ncss     = 主靶子：教育部官方校招平台，需学信网登录态
JOB_SOURCE=remoteok


# ── 通知（M8：默认关闭，本地开发绝不往外发消息）─────────────
SEND_NOTIFY=false
FEISHU_WEBHOOK_URL=


# ── 路径 ──────────────────────────────────────────────────
VAR_DIR=var
DB_PATH=var/app.db
LOG_LEVEL=INFO


# ── 抓取礼貌（M8）─────────────────────────────────────────
# ⚠️ ncss 是实名账号：翻页间隔 ≥3s + 抖动、整个流程一天只跑一次。
# ★ 这两条【刻意不是配置项】—— 硬编码在 src/agent/guardrails/ratelimit.py。
#   原先这里有 HTTP_MIN_DELAY_SECONDS / HTTP_MAX_DELAY_SECONDS，但【从未被
#   任何代码读过】；一个"改了也不生效"的配置项比没有更危险，M8 已删除。
#   可配的护栏不是护栏。
