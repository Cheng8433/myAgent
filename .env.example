# 配置模板 —— 复制为 .env 后填写。.env 已被 .gitignore 挡住，永远不要提交。
# 登录为半自动：账号密码由本人在浏览器里输入，程序只保存登录态。

# ── LLM（OpenAI 兼容接口，以下四个均为必填，代码中没有默认值）────────────
# DeepSeek: https://api.deepseek.com/v1   model: deepseek-chat
# 通义千问: https://dashscope.aliyuncs.com/compatible-mode/v1   model: qwen-plus
# BASE_URL 与 MODEL 必须成对更换，否则会把模型名发给不认识的端点。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60

# ── Agent 预算闸门（三个均为必填；缺失或留空会在启动时立即报错）─────────
AGENT_MAX_STEPS=20
AGENT_MAX_TOKENS=200000
AGENT_WALL_CLOCK_SECONDS=600

# ── 数据源 ────────────────────────────────────────────────────────────────
# remoteok = 开发期替身（零登录）；ncss = 主站点（需要学信网登录态）
JOB_SOURCE=remoteok

# ── 通知（默认关闭）───────────────────────────────────────────────────────
SEND_NOTIFY=false
FEISHU_WEBHOOK_URL=

# ── 路径与日志 ────────────────────────────────────────────────────────────
VAR_DIR=var
DB_PATH=var/app.db
LOG_LEVEL=INFO

# ── 抓取礼貌 ──────────────────────────────────────────────────────────────
# ncss 是实名账号：一天最多一次、翻页间隔 ≥3 秒。这些是硬编码护栏，不是配置项。
