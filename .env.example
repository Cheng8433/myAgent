# ═══════════════════════════════════════════════════════════
#  配置模板 —— 复制为 .env 后填写
#
#      cp .env.example .env
#
#  ⚠️ .env 已被 .gitignore 挡住，**永远不要**提交它。
#
#  注意：这里【没有】ncss 的账号密码，这是刻意的设计。
#  登录走半自动方案（PLAN.md §M2）：Playwright 打开有头浏览器，
#  由主人亲自输入账号密码并过图形验证码，程序只保存登录态。
#  也就是说 —— 凭据从不经过本程序的代码，也不落盘。
# ═══════════════════════════════════════════════════════════


# ── LLM（国内 OpenAI 兼容接口）──────────────────────────────
# DeepSeek:  https://api.deepseek.com/v1        model: deepseek-chat
# 通义千问:  https://dashscope.aliyuncs.com/compatible-mode/v1  model: qwen-plus
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# 单次 LLM 调用的超时（秒）。注意：重试不在这里做，属于编排层（M4）
LLM_TIMEOUT_SECONDS=60


# ── Agent 预算闸门（M3/M4：防止死循环烧钱）───────────────────
AGENT_MAX_STEPS=20
AGENT_MAX_TOKENS=200000
AGENT_WALL_CLOCK_SECONDS=600


# ── 数据源（M2）────────────────────────────────────────────
# remoteok = 开发期替身：零登录、零对抗、零风险，用于 M1~M3 快速迭代
# ncss     = 主靶子：教育部官方校招平台，需学信网登录态
JOB_SOURCE=remoteok


# ── 通知（M8：默认关闭，本地开发绝不往外发消息）─────────────
SEND_NOTIFY=false
FEISHU_WEBHOOK_URL=


# ── 路径 ──────────────────────────────────────────────────
VAR_DIR=var
DB_PATH=var/app.db
LOG_LEVEL=INFO


# ── 抓取礼貌（M8）─────────────────────────────────────────
# ⚠️ ncss 是实名账号，这两个值【只许调大不许调小】。
# 整个流程一天只跑一次（该上限硬编码在代码里，不做成配置项）。
HTTP_MIN_DELAY_SECONDS=3
HTTP_MAX_DELAY_SECONDS=8
